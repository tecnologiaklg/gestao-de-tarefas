# ============================================================
# .env.example — Copie para .env e preencha todas as variáveis
# ============================================================

# ── Domínio (VPS + Traefik) ───────────────────────────────────
DOMAIN=tarefas.seu-dominio.com

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=gestao_tarefas
POSTGRES_USER=app_user
POSTGRES_PASSWORD=troque_esta_senha_segura

# ── JWT (backend) ─────────────────────────────────────────────
JWT_SECRET=troque_este_segredo_jwt_longo_e_aleatorio
JWT_EXPIRES_IN=365d

# ── Root Admin ───────────────────────────────────────────────
# PIN 000000 + este token = acesso root
ROOT_ADMIN_TOKEN=troque_este_token_root_secreto

# ── Discord Bot ───────────────────────────────────────────────
DISCORD_TOKEN=seu_token_do_bot_discord_aqui

# ── Traefik ───────────────────────────────────────────────────
TRAEFIK_NETWORK=proxy

# ── Frontend API ──────────────────────────────────────────────
VITE_API_URL=/api

